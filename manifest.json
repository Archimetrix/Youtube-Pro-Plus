{
    "manifest_version": 3,
    "name": "Youtube Pro Plus",
    "version": "5.1",
    "description": "A Free powerful extension for youtube with more than 16 features to completely overhaul your youtube experience.",
    "background": {
        "service_worker": "background-sw.js"
    },
    "permissions": [
        "activeTab",
        "alarms",
        "clipboardWrite",
        "declarativeNetRequestWithHostAccess",
        "downloads",
        "notifications",
        "offscreen",
        "storage",
        "tabs",
        "unlimitedStorage",
        "webRequest"
    ],
    "host_permissions": [
        "*://formbold.com/*",
        "*://ssvid.net/*",
        "*://vidssave.com/*",
        "*://www.ssvid.net/*",
        "*://www.vidssave.com/*",
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "https://*.googlevideo.com/*",
        "https://*.onrender.com/*",
        "https://*.youtube.com/*",
        "https://api.github.com/*",
        "https://catbox.moe/*",
        "https://files.catbox.moe/*",
        "https://raw.githubusercontent.com/*",
        "https://returnyoutubedislikeapi.com/*",
        "https://sponsor.ajay.app/*"
    ],
    "icons": {
        "16": "imgs/icon16.png",
        "32": "imgs/icon32.png",
        "48": "imgs/icon48.png",
        "128": "imgs/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "imgs/icon16.png",
            "32": "imgs/icon32.png",
            "48": "imgs/icon48.png",
            "128": "imgs/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*"
            ],
            "js": [
                "browser-compat.js",
                "content.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*"
            ],
            "js": [
                "browser-compat.js",
                "sound-booster.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://ssvid.net/*",
                "*://www.ssvid.net/*",
                "*://vidssave.com/*",
                "*://www.vidssave.com/*"
            ],
            "js": [
                "browser-compat.js",
                "inject-download.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*"
            ],
            "js": [
                "browser-compat.js",
                "room-sync.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*"
            ],
            "js": [
                "return-youtube-dislike.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*"
            ],
            "js": [
                "sponsorblock.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "all_frames": true,
            "css": [
                "content-scripts/youtube.css"
            ],
            "js": [
                "content-scripts/youtube.js"
            ]
        },
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "all_frames": true,
            "css": [
                "content-scripts/youtube-main.css"
            ],
            "js": [
                "content-scripts/youtube-main.js"
            ],
            "world": "MAIN"
        },
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "all_frames": false,
            "run_at": "document_start",
            "js": [
                "content-scripts/page-sabr-fetch.js"
            ],
            "world": "MAIN"
        },
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "all_frames": true,
            "run_at": "document_start",
            "js": [
                "content-scripts/iframe-mute.js",
                "content-scripts/visibility-spoof.js"
            ],
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "features.css",
                "theme.css",
                "block-popups.css",
                "inject-speed.js",
                "imgs/playericon.svg",
                "imgs/playericon_inactive.svg",
                "imgs/redcircle.svg"
            ],
            "matches": [
                "*://www.youtube.com/*",
                "*://youtube.com/*"
            ]
        },
        {
            "resources": [
                "offscreen.html",
                "download-worker.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "key": "",
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "minimum_chrome_version": "125.0",
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "strip-youtube-frame-headers",
                "enabled": true,
                "path": "rules/strip-youtube-frame-headers.json"
            }
        ]
    }
}